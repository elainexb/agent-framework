# Shareable workspace roots. Local review material is excluded by default.
/*
!/.gitignore
!/CODEX_START_HERE.md
!/agent-foundation/
!/review/

/agent-foundation/*
!/agent-foundation/.gitignore
!/agent-foundation/.env.example
!/agent-foundation/AGENTS.md
!/agent-foundation/CODEX_START_HERE.md
!/agent-foundation/pyproject.toml
!/agent-foundation/requirements.txt
!/agent-foundation/requirements-catalog.lock
!/agent-foundation/学习地图.html
!/agent-foundation/foundation/
!/agent-foundation/agents/
!/agent-foundation/tests/
!/agent-foundation/docs/
!/agent-foundation/.agents/
!/agent-foundation/history/

/agent-foundation/.agents/*
!/agent-foundation/.agents/skills/
/agent-foundation/history/*
!/agent-foundation/history/README.md

# Business data requires a separate review; retain the synthetic handbook.
/agent-foundation/agents/*/data/*
!/agent-foundation/agents/*/data/README.*
!/agent-foundation/agents/knowledge_helper/data/handbook.md

/review/*
!/review/skill-verification-20261027/
!/review/md-governance-20261026/
/review/skill-verification-20261027/*
!/review/skill-verification-20261027/candidate/
!/review/skill-verification-20261027/test_document_contract.py
!/review/skill-verification-20261027/evidence/
/review/skill-verification-20261027/candidate/*
!/review/skill-verification-20261027/candidate/document-governance/
/review/skill-verification-20261027/candidate/document-governance/*
!/review/skill-verification-20261027/candidate/document-governance/SKILL.md
/review/skill-verification-20261027/evidence/*
!/review/skill-verification-20261027/evidence/application-20261027/
/review/skill-verification-20261027/evidence/application-20261027/*
!/review/skill-verification-20261027/evidence/application-20261027/current-cli.json
!/review/skill-verification-20261027/evidence/application-20261027/migration-map.json
!/review/skill-verification-20261027/evidence/application-20261027/application-result.json
/review/md-governance-20261026/*
